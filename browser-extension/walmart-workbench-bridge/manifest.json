{
  "manifest_version": 3,
  "name": "沃尔玛工作台 · 当前浏览器数据连接",
  "version": "2.0.0",
  "description": "复用当前 Chrome 的领星与供应链登录状态，按工作台店铺隔离同步数据。",
  "permissions": ["alarms", "storage", "tabs", "webRequest"],
  "host_permissions": [
    "https://czyxgyl.shangyiku.top/*",
    "https://czyx.lingxing.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["workbench-content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "沃尔玛工作台数据连接"
  }
}
